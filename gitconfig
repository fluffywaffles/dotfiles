[user]
	email = skorlir@gmail.com
	name = fluffywaffles
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[push]
	useForceIfIncludes = true
[rebase]
	autoStash  = true
	autoSquash = true
	updateRefs = true
[pull]
	rebase = true
[init]
	defaultBranch = trunk
[stash]
	showIncludeUntracked = true
[alias]
	sha = rev-parse --short HEAD
[rerere]
	enabled = true
	autoUpdate = false
[merge]
	conflictStyle = zdiff3
[branch]
	sort = -committerdate
[diff]
	algorithm = histogram
	colorMoved = zebra
	colorMovedWS = allow-indentation-change
	mnemonicPrefix = true
[fetch]
	prune = true
	all = true
[commit]
	verbose = true
[column]
	ui = auto,row
[feature]
	experimental = true
[grep]
	patternType = perl
