#!/bin/zsh
set -euo pipefail
setopt no_clobber

# Print the host and tty of each tmux client, most recently active first. A client attached over
# ssh is named by tailscale whois on its address, and a local one by this machine's hostname.
# Depends on tmux, tailscale and jq.

typeset activity pid tty address host

while read -r activity pid tty; do
  if [[ ! -r /proc/${pid}/environ ]]; then
    continue
  fi

  address="$(2>/dev/null tr '\0' '\n' < /proc/${pid}/environ \
    | sed --quiet 's/^SSH_CONNECTION=\([^ ]*\) .*/\1/p')" || true

  if [[ -z ${address} ]]; then
    printf '%s %s\n' ${HOST} ${tty}
    continue
  fi

  host="$(2>/dev/null tailscale whois --json ${address} \
    | jq --raw-output '.Node.Hostinfo.Hostname // empty')" || true

  if [[ -n ${host} ]]; then
    printf '%s %s\n' ${host} ${tty}
  fi
done < <(2>/dev/null tmux list-clients -F '#{client_activity} #{client_pid} #{client_tty}' \
  | sort --numeric-sort --reverse)
