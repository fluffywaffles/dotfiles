#!/bin/zsh
set -euo pipefail
setopt no_clobber

# Snapshot the tmux server's sessions, windows, layouts and pane directories, and the Claude Code
# conversation running in each pane, for tmux-restore. Each boot writes its own snapshot, so a fresh
# server saved after a reboot never overwrites the one taken before it.
# Depends on jq and pgrep.

typeset state=${XDG_STATE_HOME:-${HOME}/.local/state}/tmux-save
typeset boot="$(</proc/sys/kernel/random/boot_id)"

# Print the command resuming the pane's Claude session without its prompt. Learns which flags take a
# value from the --help of the binary the session runs; where that lists none, keeps the prompt too.
function claude_command() {
  local pane_pid=${1}
  local child registry session line signature spec flag value word taking drop keep_bare
  local -A takes
  local -a cmd kept
  for child in ${(f)"$(pgrep --parent ${pane_pid} || true)"}; do
    registry=${HOME}/.claude/sessions/${child}.json
    if [[ ! -f ${registry} ]]; then
      continue
    fi
    session=$(jq --raw-output '.sessionId // empty' ${registry})
    if [[ -z ${session} ]]; then
      continue
    fi
    cmd=(${(0)"$(</proc/${child}/cmdline)"})
    takes=()
    for line in ${(f)"$(/proc/${child}/exe --help)"}; do
      if [[ ${line} != '  -'* ]]; then
        continue
      fi
      signature=${${line#  }%%  *}
      spec=${signature##* }
      case ${spec} in
        '<'*'...>'|'['*'...]')  value=variadic ;;
        '<'*)                   value=required ;;
        '['*)                   value=optional ;;
        *)                      continue ;;
      esac
      for flag in ${(s:, :)${signature% *}}; do
        takes[${flag}]=${value}
      done
    done
    keep_bare=
    if [[ -z ${takes} ]]; then
      takes=(--resume optional -r optional)
      keep_bare=yes
    fi
    kept=(${cmd[1]})
    for word in ${cmd[2,-1]}; do
      if [[ ${word} == -- ]]; then
        break
      elif [[ ${taking} == required || ( -n ${taking} && ${word} != -* ) ]]; then
        if [[ -z ${drop} ]]; then
          kept+=(${word})
        fi
        if [[ ${taking} != variadic ]]; then
          taking=
        fi
        continue
      fi
      taking=
      if [[ ${word} != -* && -z ${keep_bare} ]]; then
        continue
      fi
      case ${word} in
        --resume|-r|--resume=*|--continue|-c)  drop=yes ;;
        *)                                     drop=; kept+=(${word}) ;;
      esac
      if [[ ${word} != *=* ]] && (( ${+takes[${word}]} )); then
        taking=${takes[${word}]}
      fi
    done
    printf '%s --resume %s' ${(j: :)${(q)kept}} ${session}
    return
  done
}

if ! 2>/dev/null tmux has-session; then
  exit 0
fi

mkdir --parents ${state}
typeset snapshot=${state}/${boot}
typeset partial=${state}/.${boot}

typeset fields=('#{session_name}' '#{window_index}' '#{window_name}' '#{automatic-rename}'
  '#{window_active}' '#{window_zoomed_flag}' '#{window_width}' '#{window_height}'
  '#{window_layout}' '#{pane_active}' '#{pane_current_path}' '#{pane_pid}')

tmux list-panes -a -F ${(pj:\t:)fields} \
  | while IFS=$'\t' read -r line; do
      printf '%s\t%s\n' ${line%$'\t'*} "$(claude_command ${line##*$'\t'})"
    done >! ${partial}
mv ${partial} ${snapshot}
