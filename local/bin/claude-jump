#!/bin/zsh
set -euo pipefail
setopt no_clobber

# Focus a tmux pane: the one given, or the one the latest Claude Code notification recorded, since
# dunstctl can action only its oldest notification. switch-client to a pane id crosses sessions,
# where select-window would leave the client where it was.
# --host runs the jump on the machine holding the pane, over this machine's ssh master to it, then
# focuses this machine's terminal. It never connects afresh: Tailscale SSH's check mode can stall
# a fresh connection on a browser prompt nobody sees.
# The client switched is this machine's most recently active one, or that of the machine
# --client-from names, which keeps the focus.
# Depends on tmux, bspc, jq, ssh and tmux-client-hosts.

function errf { >&2 printf ${@} }

function usage {
  >&2 printf 'usage: claude-jump [--host <host> | --client-from <host>] [<pane>]\n'
}

typeset bin=${0:A:h}
typeset state=${XDG_RUNTIME_DIR:-/tmp}/claude-notify.pane

# The bspwm node of the terminal running tmux, matched by class, since bspwm exposes no pid.
function terminal_node() {
  local node class

  for node in ${(f)"$(2>/dev/null bspc query -N -n .window)"}; do
    class="$(2>/dev/null bspc query -T -n ${node} | jq --raw-output '.client.className // empty')"

    case ${class} in
      Alacritty|kitty)
        printf '%s\n' ${node}
        return 0
        ;;
    esac
  done

  return 1
}

# The tty of a host's most recently active tmux client.
function attached_tty() {
  local wanted=${1} client_host tty

  while read -r client_host tty; do
    if [[ ${client_host} == "${wanted}" ]]; then
      printf '%s\n' ${tty}
      return 0
    fi
  done < <(${bin}/tmux-client-hosts)

  return 1
}

function switch_there() {
  if ! >/dev/null 2>&1 ssh -O check ${host}; then
    errf 'claude-jump: no ssh master connection to %s\n' ${host}
    return 1
  fi

  ssh -o ControlMaster=no -o ClearAllForwardings=yes ${host} \
    claude-jump --client-from ${(q)HOST%%.*} ${(q)pane}
}

function switch_here() {
  local client_host=${from:-${HOST}} tty_path

  if ! >/dev/null 2>&1 tmux has-session -t ${pane}; then
    errf 'claude-jump: pane is gone: %s\n' ${pane}
    return 1
  fi

  if ! tty_path="$(attached_tty ${client_host})"; then
    errf 'claude-jump: no client attached from %s\n' ${client_host}
    return 1
  fi

  if ! >/dev/null 2>&1 tmux switch-client -c ${tty_path} -t ${pane}; then
    errf 'claude-jump: no attached client to show %s\n' ${pane}
    return 1
  fi
}

typeset host from
typeset -a args=()

while (( # > 0 )); do
  if [[ ${1} =~ ^-+host$ && -n ${2:-} ]]; then
    host=${2}
    shift 2
  elif [[ ${1} =~ ^-+client-from$ && -n ${2:-} ]]; then
    from=${2}
    shift 2
  elif [[ ${1} == -* ]]; then
    errf 'claude-jump: unknown option or missing value: %s\n' ${1}
    usage
    exit 1
  else
    args+=(${1})
    shift 1
  fi
done

if (( ${#args} > 1 )); then
  errf 'claude-jump: unexpected argument: %s\n' ${args[2]}
  usage
  exit 1
elif [[ -n ${host} && -n ${from} ]]; then
  errf 'claude-jump: --host and --client-from exclude each other\n'
  usage
  exit 1
fi

typeset pane=${args[1]:-}

if [[ -z ${pane} && -n ${host} ]]; then
  errf 'claude-jump: --host needs a pane\n'
  usage
  exit 1
elif [[ -z ${pane} && -r ${state} ]]; then
  pane="$(< ${state})"
fi

if [[ -z ${pane} ]]; then
  errf 'claude-jump: no pane given and none recorded in %s\n' ${state}
  exit 1
fi

if [[ -n ${host} ]]; then
  if ! switch_there; then
    exit 1
  fi
elif ! switch_here; then
  exit 1
elif [[ -n ${from} ]]; then
  exit 0
fi

typeset node

node="$(terminal_node)" || exit 0

bspc node ${node} -f
