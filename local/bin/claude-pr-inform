#!/bin/zsh
set -euo pipefail
setopt no_clobber

# Tell the session its branch has an open pull request, as a SessionStart and PostToolUse hook.
# Reads the hook payload on stdin and injects the instruction to start pr-comment-watch under the
# Monitor tool. A hook cannot call that tool itself, so it asks rather than starts.
# Requires gh and jq.
#
# PostToolUse fires on every Bash call, so the payload's command is checked before anything
# reaches the network: only `gh pr create` gets past it.

typeset -r watcher=${HOME}/.local/share/brain/stem/tools/pr-comment-watch

typeset payload="$(cat)"
typeset event="$(jq --raw-output '.hook_event_name // empty' <<< ${payload})"
typeset dir="$(jq --raw-output '.cwd // empty' <<< ${payload})"

if [[ -z ${event} || -z ${dir} || ! -x ${watcher} ]]; then
  exit 0
fi

if [[ ${event} == PostToolUse ]]; then
  typeset command="$(jq --raw-output '.tool_input.command // empty' <<< ${payload})"
  if [[ ! ${command} =~ 'gh[[:space:]]+pr[[:space:]]+create' ]]; then
    exit 0
  fi
fi

if ! >/dev/null 2>&1 git -C ${dir} rev-parse --git-dir; then
  exit 0
fi

cd ${dir}

typeset pr
if ! pr="$(2>/dev/null timeout 10 gh pr view --json number,url)"; then
  exit 0
fi

typeset number="$(jq --raw-output '.number // empty' <<< ${pr})"
typeset url="$(jq --raw-output '.url // empty' <<< ${pr})"

if [[ -z ${number} || -z ${url} ]]; then
  exit 0
fi

typeset context="Pull request #${number} is open for this branch: ${url}
Unless this session is already watching it, start a watcher now, before answering: run
${watcher} ${url} under the Monitor tool with persistent true. It emits one event per new review
comment, conversation comment or submitted review, and costs nothing while the pull request is
quiet. Jordan should not have to paste review comments in."

jq --null-input --arg event ${event} --arg context ${context} \
  '{hookSpecificOutput: {hookEventName: $event, additionalContext: $context}}'
