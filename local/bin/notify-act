#!/bin/zsh
set -euo pipefail
setopt no_clobber

# Act on the newest displayed notification: summon whoever sent it, then dismiss everything that
# source has on screen, since summoning it answers all of them at once.
# Newest rather than oldest because nothing expires once pinned, so the oldest is the stalest.
# A record only claims that a notification once existed. The history is one way to tell the dead
# ones apart, but it holds the last hundred and never receives a notification its own stack tag
# replaced, so a candidate that survives it is closed and the displayed count read back: a close
# that changes nothing names a record to sweep and walk past. The whole dead pile therefore goes
# in one keypress rather than costing a keypress each.
# Records are ordered by write time rather than by id, since dunst numbers from one again after a
# restart and an id says nothing about when it was handed out across two instances.
# The dismissal comes before the summons: scratchpad execs the application when it is not already
# running, which would hold this script open for as long as that application lives.
# Depends on dunstctl, jq, notify-dismiss, claude-jump and scratchpad.

function errf { >&2 printf ${@} }

typeset dir=${XDG_RUNTIME_DIR:-/tmp}/notify-act

# Firing an action closes the notification, so closing unconditionally would consume a second,
# untouched one. The displayed count says afterwards whether an action was there to fire.
function action_or_close() {
  typeset before="$(dunstctl count displayed)"

  dunstctl action

  if [[ "$(dunstctl count displayed)" == ${before} ]]; then
    dunstctl close
  fi

  exit 0
}

typeset displayed="$(dunstctl count displayed)"

# Nothing on screen means every record is stale, whatever the history still remembers.
if (( displayed == 0 )); then
  rm --recursive --force ${dir}
  exit 0
fi

if [[ ! -d ${dir} ]]; then
  action_or_close
fi

typeset -a records
records=(${dir}/*(N.om:t))

if (( ${#records} == 0 )); then
  action_or_close
fi

typeset -a gone
gone=(${(f)"$(dunstctl history | jq --raw-output '.data[0][].id.data')"})

typeset id source='' before

for id in ${records}; do
  if (( ${gone[(Ie)${id}]} )); then
    rm --force ${dir}/${id}
    continue
  fi

  before="$(dunstctl count displayed)"
  source="$(< ${dir}/${id})"

  dunstctl close ${id}
  rm --force ${dir}/${id}

  if [[ "$(dunstctl count displayed)" != ${before} ]]; then
    break
  fi

  source=''
done

if [[ -z ${source} ]]; then
  action_or_close
fi

typeset -a summon

case ${source} in
  slack)
    summon=(scratchpad slack)
    ;;
  claude\ ?*)
    summon=(claude-jump ${source#claude })
    ;;
  *)
    errf 'notify-act: unrecognised source %s for id %s\n' ${source} ${id}
    action_or_close
    ;;
esac

notify-dismiss ${source}

exec ${summon}
