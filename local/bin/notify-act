#!/bin/zsh
set -euo pipefail
setopt no_clobber

# Act on the newest displayed notification: summon whoever sent it, then dismiss that one by id.
# Newest rather than oldest because nothing expires once pinned, so the oldest is the stalest.
# A record whose notification has left the screen is in the history, and a recent departure is
# always still in it, so the newest record absent from the history is reliably the live one.
# Depends on dunstctl, jq, claude-jump and scratchpad.

function errf { >&2 printf ${@} }

typeset dir=${XDG_RUNTIME_DIR:-/tmp}/notify-act

# Firing an action closes the notification, so closing unconditionally would consume a second,
# untouched one. The displayed count says afterwards whether an action was there to fire.
function action_or_close() {
  typeset before="$(dunstctl count displayed)"

  dunstctl action

  if [[ "$(dunstctl count displayed)" == ${before} ]]; then
    dunstctl close
  fi

  exit 0
}

typeset displayed="$(dunstctl count displayed)"

# Nothing on screen means every record is stale, whatever the history still remembers.
if (( displayed == 0 )); then
  rm --recursive --force ${dir}
  exit 0
fi

if [[ ! -d ${dir} ]]; then
  action_or_close
fi

typeset -a records
records=(${dir}/*(N.On:t))

if (( ${#records} == 0 )); then
  action_or_close
fi

typeset -a gone
gone=(${(f)"$(dunstctl history | jq --raw-output '.data[0][].id.data')"})

typeset id source=''

for id in ${records}; do
  if (( ${gone[(Ie)${id}]} )); then
    rm --force ${dir}/${id}
    continue
  fi

  source="$(< ${dir}/${id})"
  break
done

if [[ -z ${source} ]]; then
  action_or_close
fi

case ${source} in
  slack)
    scratchpad slack
    ;;
  claude\ ?*)
    claude-jump ${source#claude }
    ;;
  *)
    errf 'notify-act: unrecognised source %s for id %s\n' ${source} ${id}
    rm --force ${dir}/${id}
    action_or_close
    ;;
esac

rm --force ${dir}/${id}

dunstctl close ${id}
