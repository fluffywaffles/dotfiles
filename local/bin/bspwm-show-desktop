#!/bin/zsh

ZEN_MONITOR=focused
QUOTE_FONT_SIZE=20
CITATION_FONT_SIZE=16
CITATION_GAP=20
WRAP_WIDTH=1000
FOLD_WIDTH=70

# The desktop switches that show the desktop happen before the watcher subscribes.
DISMISS_EVENTS=(desktop_focus monitor_focus desktop_layout
                node_add node_remove node_focus
                node_transfer node_swap node_state node_geometry)

# Host files may redefine this; it must assign QUOTE_X, QUOTE_Y, CITATION_X and
# CITATION_Y, as absolute screen coordinates.
place_quote_block() {
    QUOTE_X=$(( MONITOR_X + (MONITOR_WIDTH - WRAP_WIDTH) / 2 ))
    QUOTE_Y=$(( MONITOR_Y + (MONITOR_HEIGHT - BLOCK_HEIGHT) / 2 ))
    CITATION_X=$QUOTE_X
    CITATION_Y=$(( QUOTE_Y + QUOTE_HEIGHT + CITATION_GAP ))
}

HOST_PLACEMENT="${HOME}/.config/bspwm-show-desktop/placement.$(uname -n)"
if [[ -f "$HOST_PLACEMENT" ]]; then
    source "$HOST_PLACEMENT"
fi

show_quote() {
    local RANDOM_QUOTE QUOTE CITATION
    local MONITOR_X MONITOR_Y MONITOR_WIDTH MONITOR_HEIGHT
    local QUOTE_LINES QUOTE_LINE_HEIGHT CITATION_LINE_HEIGHT QUOTE_HEIGHT BLOCK_HEIGHT
    local QUOTE_X QUOTE_Y CITATION_X CITATION_Y

    RANDOM_QUOTE=$(shuf -n 1 ~/.dotfiles/local/share/zen_quotes.txt)
    QUOTE=${RANDOM_QUOTE%%|*}
    CITATION=${RANDOM_QUOTE#*|}

    read -r MONITOR_X MONITOR_Y MONITOR_WIDTH MONITOR_HEIGHT < <(bspc query -T -m "$ZEN_MONITOR" | jq -r '.rectangle | "\(.x) \(.y) \(.width) \(.height)"')

    QUOTE_LINES=$(printf '%s\n' "$QUOTE" | fold -w $FOLD_WIDTH -s | wc -l)
    QUOTE_LINE_HEIGHT=$(( QUOTE_FONT_SIZE * 7 / 4 ))
    CITATION_LINE_HEIGHT=$(( CITATION_FONT_SIZE * 7 / 4 ))
    QUOTE_HEIGHT=$(( QUOTE_LINES * QUOTE_LINE_HEIGHT ))
    BLOCK_HEIGHT=$(( QUOTE_HEIGHT + CITATION_GAP + CITATION_LINE_HEIGHT ))

    place_quote_block

    printf '%s\n' "$QUOTE" | aosd_cat -w $WRAP_WIDTH -p 0 -x $QUOTE_X -y $QUOTE_Y -R white -S black -s 230 -r 230 -e 2 -n "Monospace $QUOTE_FONT_SIZE" -u 86400000 >/dev/null 2>&1 &
    printf '%s\n' "$CITATION" | aosd_cat -w $WRAP_WIDTH -p 0 -x $CITATION_X -y $CITATION_Y -R '#bbbbbb' -S black -s 230 -r 230 -e 2 -n "Monospace Italic $CITATION_FONT_SIZE" -u 86400000 >/dev/null 2>&1 &
}

# Each monitor switches to a new empty desktop named after the desktop it was
# showing, so restoring needs no state beyond the desktop names.
enter_empty_desktops() {
    local MONITOR PREVIOUS ZEN
    local FOCUSED_MONITOR=$(bspc query -M -m focused)
    for MONITOR in ${(f)"$(bspc query -M)"}; do
        PREVIOUS=$(bspc query -D -d "$MONITOR:focused")
        bspc monitor "$MONITOR" -a "zen-$PREVIOUS"
        ZEN=$(bspc query -D -d "zen-$PREVIOUS")
        if [[ $MONITOR == $FOCUSED_MONITOR ]]; then
            bspc desktop "$ZEN" -f
        else
            bspc desktop "$ZEN" -a
        fi
    done
}

zen_desktops() {
    local DESKTOP
    for DESKTOP in ${(f)"$(bspc query -D)"}; do
        if [[ "$(bspc query -D -d "$DESKTOP" --names)" == zen-* ]]; then
            printf '%s\n' "$DESKTOP"
        fi
    done
}

# A window opened meanwhile moves to the desktop the monitor was showing. A
# monitor still on its empty desktop goes back; one switched elsewhere stays.
restore_every_monitor() {
    local ZEN PREVIOUS NODE
    for ZEN in ${(f)"$(zen_desktops)"}; do
        PREVIOUS=$(bspc query -D -d "$ZEN" --names)
        PREVIOUS=${PREVIOUS#zen-}
        for NODE in ${(f)"$(bspc query -N -d "$ZEN" -n .window)"}; do
            bspc node "$NODE" -d "$PREVIOUS"
        done
        if [[ "$(bspc query -D -d focused)" == $ZEN ]]; then
            bspc desktop "$PREVIOUS" -f
        elif [[ -n "$(bspc query -D -d "$ZEN.active")" ]]; then
            bspc desktop "$PREVIOUS" -a
        fi
        bspc desktop "$ZEN" -r
    done
    killall aosd_cat 2>/dev/null
}

showing_desktop() {
    [ -n "$(zen_desktops)" ] || pgrep -x aosd_cat >/dev/null
}

dismiss_on_next_event() {
    bspc subscribe --count 1 "${DISMISS_EVENTS[@]}" >/dev/null 2>&1
    if showing_desktop; then
        restore_every_monitor
    fi
}

if showing_desktop; then
    restore_every_monitor
else
    enter_empty_desktops
    show_quote
    dismiss_on_next_event &
fi
