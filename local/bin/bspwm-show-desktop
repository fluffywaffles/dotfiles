#!/bin/bash

ZEN_MONITOR=focused
QUOTE_FONT_SIZE=20
CITATION_FONT_SIZE=16
CITATION_GAP=20
WRAP_WIDTH=1000
FOLD_WIDTH=70

# Everything except node_flag, which is what hiding and unhiding themselves emit.
DISMISS_EVENTS=(desktop_focus monitor_focus desktop_layout
                node_add node_remove node_focus
                node_transfer node_swap node_state node_geometry)

# Host files may redefine this; it must assign QUOTE_X, QUOTE_Y, CITATION_X and
# CITATION_Y, as absolute screen coordinates.
place_quote_block() {
    QUOTE_X=$(( MONITOR_X + (MONITOR_WIDTH - WRAP_WIDTH) / 2 ))
    QUOTE_Y=$(( MONITOR_Y + (MONITOR_HEIGHT - BLOCK_HEIGHT) / 2 ))
    CITATION_X=$QUOTE_X
    CITATION_Y=$(( QUOTE_Y + QUOTE_HEIGHT + CITATION_GAP ))
}

HOST_PLACEMENT="${HOME}/.config/bspwm-show-desktop/placement.$(uname -n)"
if [[ -f "$HOST_PLACEMENT" ]]; then
    source "$HOST_PLACEMENT"
fi

show_quote() {
    RANDOM_QUOTE=$(shuf -n 1 ~/.dotfiles/local/share/zen_quotes.txt)
    QUOTE=$(echo "$RANDOM_QUOTE" | cut -d '|' -f1)
    CITATION=$(echo "$RANDOM_QUOTE" | cut -d '|' -f2)

    read -r MONITOR_X MONITOR_Y MONITOR_WIDTH MONITOR_HEIGHT < <(bspc query -T -m "$ZEN_MONITOR" | jq -r '.rectangle | "\(.x) \(.y) \(.width) \(.height)"')

    LINES=$(echo "$QUOTE" | fold -w $FOLD_WIDTH -s | wc -l)
    QUOTE_LINE_HEIGHT=$(( QUOTE_FONT_SIZE * 7 / 4 ))
    CITATION_LINE_HEIGHT=$(( CITATION_FONT_SIZE * 7 / 4 ))
    QUOTE_HEIGHT=$(( LINES * QUOTE_LINE_HEIGHT ))
    BLOCK_HEIGHT=$(( QUOTE_HEIGHT + CITATION_GAP + CITATION_LINE_HEIGHT ))

    place_quote_block

    echo "$QUOTE" | aosd_cat -w $WRAP_WIDTH -p 0 -x $QUOTE_X -y $QUOTE_Y -R white -S black -s 230 -r 230 -e 2 -n "Monospace $QUOTE_FONT_SIZE" -u 86400000 >/dev/null 2>&1 &
    echo "$CITATION" | aosd_cat -w $WRAP_WIDTH -p 0 -x $CITATION_X -y $CITATION_Y -R '#bbbbbb' -S black -s 230 -r 230 -e 2 -n "Monospace Italic $CITATION_FONT_SIZE" -u 86400000 >/dev/null 2>&1 &
}

hide_every_monitor() {
    for node in $(bspc query -N -d .active -n .window.!hidden); do
        bspc node "$node" -g hidden=on
    done
}

restore_every_monitor() {
    for node in $(bspc query -N -n .hidden); do
        bspc node "$node" -g hidden=off
    done
    killall aosd_cat 2>/dev/null
}

# The desktop being switched away from is no longer .active, so this waits on
# the event and then re-queries for hidden windows wherever they ended up.
dismiss_on_next_event() {
    bspc subscribe --count 1 "${DISMISS_EVENTS[@]}" >/dev/null 2>&1
    if [ -n "$(bspc query -N -n .hidden)" ]; then
        restore_every_monitor
    fi
}

if [ -n "$(bspc query -N -n .hidden)" ]; then
    restore_every_monitor
else
    hide_every_monitor
    show_quote
    dismiss_on_next_event &
fi
