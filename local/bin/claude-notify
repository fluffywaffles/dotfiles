#!/bin/zsh
set -euo pipefail
setopt no_clobber

# Raise a libnotify notification from a Claude Code Notification hook payload on stdin,
# titled with the tmux window the session runs in. Inside tmux the notification is spooled and
# raised by claude-notify-listen instead, so its Jump action outlives this hook process.
# Depends on jq, notify-send, tmux and systemctl.

function errf { >&2 printf ${@} }

typeset state=${XDG_RUNTIME_DIR:-/tmp}/claude-notify.pane

typeset payload="$(cat)"

if [[ -z ${payload} ]]; then
  errf 'claude-notify: empty payload on stdin\n'
  exit 1
fi

typeset event="$(jq --raw-output '.hook_event_name // empty' <<< ${payload})"
typeset title="$(jq --raw-output '.title // empty' <<< ${payload})"
typeset message="$(jq --raw-output '.message // empty' <<< ${payload})"
typeset kind="$(jq --raw-output '.notification_type // empty' <<< ${payload})"

# Default to the category that persists: a type not named here is more likely to be Claude
# waiting than a status report, and an unrecognised one should not expire unseen.
typeset category=claude.waiting

if [[ ${event} == Stop ]]; then
  category=claude.done
  message="$(jq --raw-output '.last_assistant_message // empty' <<< ${payload})"
  message="${message//$'\n'/ }"

  if (( ${#message} > 140 )); then
    message="${message[1,140]}…"
  fi

  if [[ -z ${message} ]]; then
    message='finished responding'
  fi
else
  case ${kind} in
    auth_success|computer_use_enter|computer_use_exit|elicitation_complete|elicitation_response)
      category=claude.info
      ;;
    quota_auto_resume_fired|quota_auto_resume_stale|quota_auto_resume_disabled)
      category=claude.info
      ;;
  esac
fi

# The title is the only part reliably read at a glance, so it leads with what happened rather
# than only where.
typeset label

if [[ ${event} == Stop ]]; then
  label=done
else
  case ${kind} in
    permission_prompt|worker_permission_prompt) label='needs permission' ;;
    agent_needs_input)                          label='needs input' ;;
    elicitation_dialog|elicitation_url_dialog)  label='needs input' ;;
    idle_prompt)                                label='waiting' ;;
    agent_completed)                            label='agent done' ;;
    *)                                          label='notice' ;;
  esac
fi

# Only something actually waiting on an answer earns normal urgency; a finished turn and the
# status reports stay out of the way at low.
typeset urgency=low

if [[ ${category} == claude.waiting ]]; then
  urgency=normal
fi

typeset location

if [[ -n ${TMUX_PANE:-} ]]; then
  location="$(2>/dev/null tmux display-message -p -t ${TMUX_PANE} \
    '#{window_name} [#{session_name}:#{window_index}.#{pane_index}]')"
fi

typeset header=${location}

if [[ -z ${header} ]]; then
  header=${title}
fi

if [[ -z ${header} ]]; then
  header='Claude Code'
fi

header="${label} · ${header}"

if [[ -z ${location} ]]; then
  notify-send --app-name=claude-code --urgency=${urgency} --category=${category} ${header} ${message}
  exit 0
fi

printf '%s\n' ${TMUX_PANE} >! ${state}

typeset spool=${XDG_RUNTIME_DIR:-/tmp}/claude-notify

mkdir --parents ${spool}

jq --null-input \
  --arg urgency ${urgency} \
  --arg category ${category} \
  --arg header ${header} \
  --arg message ${message} \
  '{urgency: $urgency, category: $category, header: $header, message: $message}' \
  >! ${spool}/${TMUX_PANE}.json

systemctl --user restart \
  "$(systemd-escape --template=claude-notify-listen@.service ${TMUX_PANE})"
