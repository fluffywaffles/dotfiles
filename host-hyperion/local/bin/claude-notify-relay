#!/bin/zsh
set -euo pipefail
setopt no_clobber

# Raise a Claude Code notification relayed from verdure, read as one JSON object on stdin. Runs as
# claude-notify-relay@.service, one instance per connection to the socket this machine's ssh
# session to verdure forwards back here. The stack tag keeps one notification per verdure pane, plus one shared by
# every relay naming no pane, and its relay- prefix keeps notify-act from looking that pane up in
# this machine's tmux.
# Depends on jq and notify-send.

function errf { >&2 printf ${@} }

typeset payload="$(cat)"

if [[ -z ${payload} ]]; then
  errf 'claude-notify-relay: empty payload on stdin\n'
  exit 1
fi

typeset urgency="$(jq --raw-output '.urgency // empty' <<< ${payload})"
typeset category="$(jq --raw-output '.category // empty' <<< ${payload})"
typeset header="$(jq --raw-output '.header // empty' <<< ${payload})"
typeset message="$(jq --raw-output '.message // empty' <<< ${payload})"
typeset pane="$(jq --raw-output '.pane // empty' <<< ${payload})"

notify-send --app-name=claude-code --urgency=${urgency:-normal} \
  --category=${category:-claude.waiting} \
  --hint=string:x-dunst-stack-tag:claude-relay-${pane} ${header:-Claude Code} ${message}
