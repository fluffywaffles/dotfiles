#
# git-branch-current
#
# returns the local ref name for the currently checked-out HEAD
#
function git-branch-current () {(
  setopt err_exit
  git rev-parse --abbrev-ref HEAD
)}

#
# git-branch-upstream
#
# returns the remote ref name for the upstream configured for HEAD
#
function git-branch-upstream () {(
  setopt err_exit
  git rev-parse --abbrev-ref HEAD@{u}
)}

#
# git-push-set-upstream-branch-current
#
# pushes the current HEAD to a remote branch (${1}), setting upsteam to
# the remote branch (${1}), on the branch's configured remote, or origin
# when it has none or tracks a local branch. the remote can be overridden
# as a variable, as in:
#
#   remote=xyz gpu
#
# the positional argument for remote branch defaults to the current branch
# name; so, without arguments, this creates the local branch if it does
# not exist at the remote.
#
function git-push-set-upstream-branch-current () {(
  setopt err_exit
  local branch=$(git rev-parse --abbrev-ref HEAD) # git-branch-current
  local configured=$(git config --get branch.${branch}.remote)
  local remote=${remote:-${${configured:#.}:-origin}}
  local remote_branch=${1:-${branch}}
  setopt xtrace
  git push ${remote} --set-upstream ${remote_branch}
)}

# git-pull-rebase
#
# shorthand for `git pull --rebase=true` with custom flags for modifying
# the rebase option, and passthrough for any other flags.
#
# custom flags expand as follows:
#   (no flags)          ->   --rebase=true
#   -i --interactive    ->   --rebase=interactive
#   -n --no-rebase      ->   --rebase=false
#
function git-pull-rebase () {(
  setopt err_exit
  local rebase_opt=true flags=() match mbegin mend
  while true; do
    if   [[ ${1} =~ ^-+i(nteractive)*$ ]]; then shift; rebase_opt=interactive; flags+=("--autosquash");
    elif [[ ${1} =~ ^-+n(o-rebase)*$   ]]; then shift; rebase_opt=false;
    elif [[ ${1} =~ ^-+[[:alnum:]-]+$  ]]; then shift; flags+=(${match});
    else break;
    fi
  done
  setopt xtrace
  git pull ${flags[@]} --rebase=${rebase_opt} ${@}
)}

#
# git-pull-rebase-origin-main
#
# rebase remote branch (${1}) from remote (${remote}) into the currently
# checked-out HEAD. remote can be configured as a variable, as in:
#
#   remote=xyz glom
#
# the positional argument defaults to the configured default branch name;
# that is:
#
#   git config init.defaultbranch
#
# this is often 'master', but can be altered in ${HOME}/.gitconfig.
#
function git-pull-rebase-origin-main () {(
  setopt err_exit
  local rebase_opt=true flags=() match mbegin mend
  while [[ ${1} =~ ^-+[[:alnum:]-]+$ ]]; do shift; flags+=(${match}); done
  local remote=${remote:-origin}
  local default_ref=$(git-origin-default-branch ${remote})
  local default_branch=${default_ref#refs/remotes/${remote}/}
  local branch=${1:-${default_branch:-$(git config init.defaultbranch)}}
  git-pull-rebase ${flags[@]} ${remote} ${branch}
)}

#
# git-pull-rebase-then-force-push-origin-with-lease-includes
#
# rebase given upstream branch (${1}) into current branch and then
# force-push to given downstream branch (${2}) with lease. upstream and
# downstream default to the remotes for HEAD@{upstream} and HEAD@{push}
# respectively. these can be configured as variables, like so:
#
#   upstream=upstream downstream=production glop
#
#     pulls from upstream/{upstream-branch}
#     pushes to production/{downstream-branch}
#
# technically, the upstream and downstream can customize the branches too:
#
#   upstream=origin/main downstream=fork/trunk glop
#
#     pulls from origin/main into current HEAD
#     pushes to fork/trunk with current HEAD
#
# positional arguments default to the currently checked-out HEAD.
#   ${1} selects a different upstream branch to rebase into HEAD
#   ${2} selects a different downstream branch to force-push-with-lease
#
# note that the positional branches supersede branch names given by the
# upstream and downstream variables, if any.
#
# the typical use-case is:
#   glop main
#
# this pulls-with-rebase from the upstream mainline branch, then
# force-pushes to the downstream branch for HEAD.
#
# typically, the upstream downstream are the same, and so:
#   glop main
# is the same as:
#   git pull --rebase origin main && git push --force-with-lease --force-if-includes
#
function git-pull-rebase-then-force-push-origin-with-lease-includes () {(
  setopt err_exit
  # parse upstream (pull target)
  local upstream=${upstream:-$(git rev-parse --abbrev-ref HEAD@{upstream})}
  local upstream_remote upstream_branch
  if [[ ${upstream} =~ [[:alnum:]]+/[[:alnum:]]+ ]]; then
    upstream=(${(s:/:)upstream})
    upstream_remote=${upstream[1]}
    upstream_branch=${(j:/:)upstream[2,-1]}
  fi
  # parse downstream (push target)
  local downstream=${downstream:-$(git rev-parse --abbrev-ref HEAD@{push})}
  local downstream_remote downstream_branch
  if [[ ${downstream} =~ [[:alnum:]]+/[[:alnum:]]+ ]]; then
    downstream=(${(s:/:)downstream})
    downstream_remote=${downstream[1]}
    downstream_branch=${(j:/:)downstream[2,-1]}
  fi
  #
  # passthrough flags:
  #   -l* and --pull-* are flags for git-pull; e.g. -ln, --pull-no-rebase
  #   -p* and --push-* are flags for git-push; e.g. -pf, --push-force
  #
  local pull_flags=() push_flags=() match mbegin mend
  while true; do
    if   [[ ${1} =~ ^-+(p|push)-*([[:alnum:]-]+)$ ]]; then shift; push_flags+=("-${match[2]}");
    elif [[ ${1} =~ ^-+(l|pull)-*([[:alnum:]-]+)$ ]]; then shift; pull_flags+=("-${match[2]}");
    elif [[ ${1} =~ ^-+[[:alnum:]-]+$             ]]; then shift; pull_flags+=(${match});
    else break;
    fi
  done
  #
  # positional arguments can customize the upstream or downstream branch
  #
  local pull_branch=${1:-${upstream_branch}}
  local push_branch=${2:-${downstream_branch}}
  # pull
  git-pull-rebase ${pull_flags[@]} ${upstream_remote} ${pull_branch}
  setopt xtrace
  git push --force-with-lease --force-if-includes ${downstream_remote} ${push_branch}
)}

#
# git-origin-default-branch
#
# returns the default branch for a given remote (default: origin) using
# symbolic-ref.
#
function git-origin-default-branch () {
  local remote=${1:-origin}
  local symref=$(git symbolic-ref refs/remotes/${remote}/HEAD 2>/dev/null)
  if [[ -n "${symref}" ]]; then
    echo "${symref}"
    return 0
  fi

  # Fallback if the remote symbolic-ref isn't set
  local fallback=$(git config init.defaultbranch || echo main)
  if git rev-parse --verify --quiet refs/remotes/${remote}/${fallback} >/dev/null; then
    echo "refs/remotes/${remote}/${fallback}"
    return 0
  elif git rev-parse --verify --quiet refs/remotes/${remote}/master >/dev/null; then
    echo "refs/remotes/${remote}/master"
    return 0
  fi

  return 1
}

#
# git-ensure-push-extends-base
#
# Validates that the branch we are pushing extends beyond the default integration
# branch of the repository (or @{upstream} as a last resort). Prevents accidentally
# publishing pure upstream content under a new label.
#
function git-ensure-push-extends-base () {
  local remote=${1:-origin}
  local branch=${2:-HEAD}
  local default_branch=${base_branch:-$(git-origin-default-branch ${remote})}

  [[ -z "${default_branch}" ]] && default_branch=$(git rev-parse --abbrev-ref HEAD@{upstream} 2>/dev/null)

  if [[ -z "${default_branch}" ]]; then
    echo "warning: skipping push safety checks (no default branch found)" >&2
    return 0
  fi

  local base=$(git merge-base "${default_branch}" HEAD)

  git merge-base --is-ancestor "${branch}" HEAD || { echo "fatal: not in this branch's history" >&2; return 1; }
  git merge-base --is-ancestor "${branch}" "${base}" && { echo "fatal: already upstream" >&2; return 1; }
  return 0
}

#
# git-push-current-branch
#
# push the currently checked-out HEAD to remote branch (${1}), on the
# branch's configured remote, or origin when it has none or tracks a local
# branch. the remote can be overridden as a variable, as in:
#
#   remote=xyz gpc
#
# supports passthrough flags, as in:
#
#   gpc --force-with-lease --force-if-includes
#
# the positional argument defaults to the current branch name.
#
# providing a different branch name does not change the local branch name,
# nor does it set an upstream; it just pushes to that name, on the remote.
#
function git-push-current-branch () {(
  setopt err_exit
  local flags=() match mbegin mend
  while [[ ${1} =~ ^(-+[-[:alnum:]]+)$ ]]; do shift; flags+=(${match}); done
  local branch=$(git rev-parse --abbrev-ref HEAD) # git-branch-current
  # named arguments
  local configured=$(git config --get branch.${branch}.remote)
  local remote=${remote:-${${configured:#.}:-origin}}

  git-ensure-push-extends-base "${remote}" "${branch}"

  # positional arguments
  local remote_branch=${1:-${branch}}
  setopt xtrace
  git push ${flags[@]} ${remote} ${branch}:${remote_branch}
)}

#
# git-amend-then-force-push
#
# amend the current HEAD commit, then force-push to the remote branch
# (${1}). remote can be configured as a variable, as in:
#
#   remote=xyz git-amend-then-force-push
#
# supports passthrough flags for the `git commit amend`, as in:
#
#   git-amend-then-force-push --no-edit
#
# customarily, one uses the following aliases with this function:
#
#   gapf='git-amend-then-force-push --no-edit'
#   gapfe='git-amend-then-force-push'
#
# note that the shorter alias is `--no-edit`, and both aliases could be
# roughly pronounced as "gaffe," as in, "an unintentional public mistake."
#
# the positional argument defaults to the current branch name.
#
# providing a different branch name does not change the local branch name,
# nor does it set an upstrea; it just pushes to that name, on the remote.
#
function git-amend-then-force-push () {(
  setopt err_exit
  local flags=() match mbegin mend
  while [[ ${1} =~ ^(-+[-[:alnum:]]+)$ ]]; do shift; flags+=(${match}); done
  # amend, then proxy to git-push-current-branch
  setopt xtrace
  git commit --amend ${flags[@]}
  unsetopt xtrace
  git-push-current-branch --force-if-includes --force-with-lease ${1}
)}

#
# git-cd-toplevel
#
# change directory into the top-level directory of the current git repo.
#
function git-cd-toplevel () {
  local root=$(git rev-parse --show-toplevel)
  [[ -n "${root}" ]] && cd ${root}
}

#
# git-branch-default-verbose
#
# runs `git branch -v` when no arguments are provided, otherwise `git branch ${@}`
#
function git-branch-default-verbose () {(
  setopt err_exit
  if [[ ${#} -eq 0 ]]; then
    git branch -v
  else
    git branch ${@}
  fi
)}

